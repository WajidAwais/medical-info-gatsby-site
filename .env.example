# Copy to .env for builds against a real Kontent project.
# Leave it out and run with KONTENT_MOCK=1 to build from fixtures/kontent instead.

# Project settings -> API keys in Kontent
GATSBY_KONTENT_PROJECT_ID=00000000-0000-0000-0000-000000000000
# Delivery API base URL, including the trailing slash
GATSBY_DELIVERY_API_URL=https://deliver.kontent.ai/
# Language codenames separated by ","; the first one is the default
GATSBY_KONTENT_LANGUAGE_CODENAMES=en,de
# Optional: page slugs served at the language root (comma separated)
# GATSBY_HOME_PAGE_SLUGS=heart-failure-and-tr,herzinsuffizienz-und-ti
# Preview API key; only needed for Kontent Web Spotlight preview builds
GATSBY_KONTENT_PREVIEW_KEY=replace-with-preview-api-key
GATSBY_KONTENT_PREVIEW_KEY_ENABLED=false
# "development" also creates /preview/<language>/… pages for Web Spotlight
ENVIRONMENT=production
