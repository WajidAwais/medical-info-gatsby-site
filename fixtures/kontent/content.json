        "styling_options__padding_bottom": [{ "codename": "n3", "name": "3" }],
        "content": "<h2>Preparing for a specialist visit</h2><p>Two cards below are linked items inside a rich text element, the same way editors embed components in Kontent.</p><object type=\"application/kenticocloud\" data-type=\"item\" data-rel=\"component\" data-codename=\"home_cards\"></object>"
